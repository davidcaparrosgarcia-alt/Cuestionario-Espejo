# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# En Vercel: Configurar siempre (secorp)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Modelo a usar (ej: gemini-2.5-flash)
# Recomendado inicial para Vercel: gemini-2.5-flash
# Si no está, usa el fallback definido en código.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAILS=
APP_PUBLIC_URL=

# Firebase Admin Configuration for secure persistence
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=

# Secret token for server-to-server communication with SoyBienestar
QUESTIONNAIRE_BRIDGE_SECRET=

# Secret and URL for outbound SoyBienestar integration (notifications)
SOYBIENESTAR_WEBHOOK_URL=
SOYBIENESTAR_BRIDGE_SECRET=
