rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: email (lowercase)
    // Fields:
    //   - email: string (required)
    //   - pin: string (required)
    //   - nombre: string (required)
    //   - securityQuestion: string (required)
    //   - securityAnswer: string (required)
    //
    // Collection: patients
    // Document ID: patientId
    // Fields:
    //   - id: string (required)
    //   - nombre: string (required)
    //   - edad: string
    //   - sexo: string
    //   - observaciones: string
    //   - telefono: string
    //   - email: string
    //   - coordinatorEmail: string
    //   - status: string (pending, sent, viewed, completed, concluded, finalized)
    //   - answers: map
    //   - conversationSummary: string
    //   - finalConclusion: string
    //   - conclusionViews: number
    //   - accessPin: string
    //   - dateSent: number
    //   - dateAnswered: number
    //   - dateConclusionSent: number
    //   - dateConclusionViewed: number
    //   - audioConclusion: string
    //
    // Collection: questionnaires
    // Document ID: active
    // Fields:
    //   - questions: list
    //
    // Collection: config
    // Document ID: global_config
    // Fields:
    //   - welcomeText: string
    //   - welcomeAudio: map
    //   - ... (otros campos de GlobalConfig)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAuthenticatedEmail() {
      return isAuthenticated() &&
             'email' in request.auth.token &&
             request.auth.token.email is string;
    }

    function isOwner(email) {
      return hasAuthenticatedEmail() &&
             email is string &&
             request.auth.token.email.lower() == email.lower();
    }

    function hasAuthorizedCoordinatorIdentity() {
      let identity = get(/databases/$(database)/documents/authorizedCoordinators/$(request.auth.uid)).data;
      return hasAuthenticatedEmail() &&
             exists(/databases/$(database)/documents/authorizedCoordinators/$(request.auth.uid)) &&
             identity.uid == request.auth.uid &&
             identity.email == request.auth.token.email.lower() &&
             identity.role == "admin" &&
             identity.active == true;
    }

    function hasValidCoordinatorSession() {
      let session = get(/databases/$(database)/documents/coordinatorSessions/$(request.auth.uid)).data;
      return isAuthenticated() &&
             'auth_time' in request.auth.token &&
             exists(/databases/$(database)/documents/coordinatorSessions/$(request.auth.uid)) &&
             session.uid == request.auth.uid &&
             session.authTime == request.auth.token.auth_time &&
             session.expiresAt is timestamp &&
             request.time < session.expiresAt;
    }

    function hasCoordinatorAccess() {
      return hasAuthorizedCoordinatorIdentity() && hasValidCoordinatorSession();
    }

    function isAdmin() {
      return hasCoordinatorAccess();
    }

    function isCoordinatorOf(patientData) {
      return hasCoordinatorAccess() &&
             patientData is map &&
             'coordinatorEmail' in patientData &&
             patientData.coordinatorEmail is string &&
             request.auth.token.email == patientData.coordinatorEmail;
    }

    function isPrivatePatientConclusionAudio(audioData) {
      return audioData is map &&
             'kind' in audioData &&
             audioData.kind == "patient_conclusion";
    }

    function isPrivateAudioOwner(audioData) {
      return hasCoordinatorAccess() &&
             audioData is map &&
             'coordinatorEmail' in audioData &&
             isOwner(audioData.coordinatorEmail);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{email} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /authorizedCoordinators/{uid} {
      allow read, write: if false;
    }

    match /coordinatorSessions/{uid} {
      allow read, write: if false;
    }

    match /coordinatorAccessRateLimits/{bucketId} {
      allow read, write: if false;
    }

    match /patientAccessRateLimits/{bucketId} {
      allow read, write: if false;
    }

    match /patients/{patientId} {
      allow get, list: if isAdmin() || isCoordinatorOf(resource.data);
      allow create: if isAdmin() || (
        isCoordinatorOf(request.resource.data) &&
        'id' in request.resource.data &&
        request.resource.data.id is string &&
        request.resource.data.id == patientId
      );
      allow update: if isAdmin() || (
        isCoordinatorOf(resource.data) &&
        isCoordinatorOf(request.resource.data) &&
        'id' in resource.data &&
        'id' in request.resource.data &&
        resource.data.id is string &&
        request.resource.data.id is string &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.id == patientId &&
        request.resource.data.coordinatorEmail == resource.data.coordinatorEmail
      );
      allow delete: if isAdmin() || isCoordinatorOf(resource.data);
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questionnaires/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audios/{audioId} {
      allow get: if !isPrivatePatientConclusionAudio(resource.data) ||
                    isAdmin() ||
                    isPrivateAudioOwner(resource.data);
      allow list: if isAdmin();

      allow create: if hasCoordinatorAccess() && (
        !isPrivatePatientConclusionAudio(request.resource.data) ||
        isAdmin() ||
        isPrivateAudioOwner(request.resource.data)
      );

      allow update: if hasCoordinatorAccess() && (
        (
          !isPrivatePatientConclusionAudio(resource.data) &&
          !isPrivatePatientConclusionAudio(request.resource.data)
        ) ||
        isAdmin() ||
        (
          isPrivatePatientConclusionAudio(resource.data) &&
          isPrivatePatientConclusionAudio(request.resource.data) &&
          isPrivateAudioOwner(resource.data) &&
          request.resource.data.kind == resource.data.kind &&
          request.resource.data.coordinatorEmail == resource.data.coordinatorEmail
        )
      );

      allow delete: if hasCoordinatorAccess() && (
        !isPrivatePatientConclusionAudio(resource.data) ||
        isAdmin() ||
        isPrivateAudioOwner(resource.data)
      );
    }

    match /test/{testId} {
      allow read, write: if isAdmin();
    }
  }
}
