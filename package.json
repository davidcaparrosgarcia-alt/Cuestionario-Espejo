{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/patientAccess.test.ts",
    "test:integration": "node scripts/run-firestore-emulator-tests.mjs integration",
    "test:integration:runner": "tsx --test tests/integration/patientAccess.integration.test.ts",
    "test:security": "node scripts/run-firestore-emulator-tests.mjs security",
    "test:security:runner": "tsx --test tests/security/firestore.security.test.ts",
    "test:emulator": "node scripts/run-firestore-emulator-tests.mjs all",
    "test:emulator:runner": "node scripts/run-emulator-layers.mjs",
    "test:e2e": "node scripts/run-browser-e2e-tests.mjs",
    "test:e2e:runner": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.3.0",
    "@google/genai": "^1.48.0",
    "@huggingface/transformers": "^4.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^8.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
